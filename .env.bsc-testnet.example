# Public network settings (not secrets)
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org

# Disposable testnet secrets. Never commit a populated copy.
DEPLOYER_PRIVATE_KEY=
TESTNET_MNEMONIC=
BSCSCAN_API_KEY=

# The testnet deploy script derives the company recipient at mnemonic index
# 1004 and prints it with the other disposable role/economic addresses.

# Filled from DeployBscTestnet output. This is disposable mock RWAAN.
MOCK_RWAAN_ADDRESS=
MEMBERSHIP_ADDRESS=

# Resumable campaign controls
WALLET_START=0
WALLET_END=100
STAGE_START=0
STAGE_END=3

# Bit 0 enables sponsor-first placement only at the $20 stage.
# Stages 1-5 use root BFS to make rollover and award counts exact.
SPONSOR_FIRST_MASK=1

# 0.001 tBNB per disposable wallet/role at the current testnet gas price.
MEMBER_GAS_WEI=1000000000000000
ROLE_GAS_WEI=1000000000000000
MEMBER_MRWAAN=10000000000000000000000
TEST_AWARD_AMOUNT=1000000000000000000
