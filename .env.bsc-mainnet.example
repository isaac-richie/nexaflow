# BinaryMembershipV2 RWAAN BSC mainnet operations template.
NETWORK_NAME=bsc-mainnet
BSC_MAINNET_CHAIN_ID=56
BSC_MAINNET_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_EXPLORER_URL=https://bscscan.com
BSCSCAN_API_KEY=
BSC_RWAAN_ADDRESS=0xACB921bf2Dac2F7E8E101AAd9CA013d6Af5C648a
BSC_RWAAN_DECIMALS=18
RWAAN_WBNB_PAIR_ADDRESS=0xA285059BBc89Fe9B43414D098318675462aaa3e6
CHAINLINK_BNB_USD_FEED=0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE

# Deploy the TWAP oracle first, wait TWAP_PERIOD_SECONDS, call updateFromEnv(),
# then use the initialized oracle for the membership deployment.
# TWAP window. 1 hour: ~2x cheaper to manipulate than 2h, still 2x dearer
# than 30m. The attacker must re-skew the pool every block for the whole
# window, so this is the security parameter, not a refresh-rate preference.
TWAP_PERIOD_SECONDS=3600
# How stale a Chainlink BNB/USD round may be. The feed updates roughly every
# 23 seconds, so 1 hour is ~150x slack and exists only to ride out a real
# outage. Independent of the TWAP window: the oracle enforces this itself.
BNB_FEED_MAX_AGE_SECONDS=3600
EXPECTED_PRICE_ORACLE_ADDRESS=
PRICE_ORACLE_ADDRESS=
ORACLE_DEPLOYMENT_TX_HASH=
ORACLE_DEPLOYMENT_BLOCK=
ORACLE_INITIAL_UPDATE_TX_HASH=
ORACLE_INITIAL_UPDATE_BLOCK=
# How stale a RWAAN TWAP the membership contract will price against. With a
# 1 hour TWAP period this gives the keeper 8 update cycles of margin, so three
# consecutive missed updates still cannot stop registration. Widening this
# costs nothing in manipulation resistance, which is why it, and not the TWAP
# period, is the right lever for keeper headroom.
MAX_PRICE_AGE_SECONDS=28800

# Shared deployment/control EOA. With ALLOW_SHARED_CONTROL_ADDRESS=true this
# must equal ADMIN_ADDRESS, OPERATOR_ADDRESS and PAUSER_ADDRESS, but not treasury
# or root.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Shared EOA control wallet for the selected launch policy. Treasury and root
# remain separate; setting either policy switch false restores stricter checks.
ADMIN_ADDRESS=
OPERATOR_ADDRESS=
TREASURY_ADDRESS=
# Receives exactly 50% of every V2 treasury withdrawal. Must differ from the
# treasury and root addresses; it is constructor-bound and manifest-committed.
COMPANY_WALLET_ADDRESS=
PAUSER_ADDRESS=

# Economic root; must differ from the shared control address and treasury.
ROOT_ADDRESS=

# Delay for TRANSFERRING DEFAULT_ADMIN_ROLE. This does not timelock normal admin
# calls; configure the admin Safe/Delay Module separately for runtime delay.
ADMIN_DELAY_SECONDS=600
ALLOW_EOA_ROLES=true
ALLOW_SHARED_CONTROL_ADDRESS=true

# First run DeployBscMainnet.predictFromEnv(), independently record both printed
# values, then set the exact values here before any broadcast. The manifest also
# locks COMPANY_WALLET_ADDRESS, OPERATOR_ADDRESS and PAUSER_ADDRESS.
EXPECTED_MEMBERSHIP_ADDRESS=
EXPECTED_ROLE_MANIFEST_HASH=

# Fill only after deployment. ConfigureBscMainnet requires this to equal the
# expected address and emits the atomic Safe configuration batch.
MEMBERSHIP_ADDRESS=
DEPLOYMENT_TX_HASH=
DEPLOYMENT_BLOCK=
SOURCE_VERIFIED=false
CONFIGURATION_VERIFIED=false

# Public frontend/indexer handoff values.
FRONTEND_CHAIN_ID=56
FRONTEND_RPC_URL=https://bsc-dataseed.bnbchain.org
FRONTEND_RWAAN_ADDRESS=0xACB921bf2Dac2F7E8E101AAd9CA013d6Af5C648a
FRONTEND_MEMBERSHIP_ADDRESS=
INDEXER_START_BLOCK=
