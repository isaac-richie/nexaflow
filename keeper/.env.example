# NexaFlow oracle keeper

# The membership contract. The keeper reads the oracle address FROM it, so a
# misconfigured oracle cannot silently point the keeper at the wrong feed.
MEMBERSHIP_ADDRESS=0x3fAaDAac24A953a623B01e77D5b70Bfdc7E08cE0

# A DEDICATED wallet that holds gas and nothing else.
#
# update() is permissionless, so this key has no power over the protocol. Never
# put the admin, operator, treasury or root key here. Fund it with a small BNB
# float and top it up when the keeper warns.
KEEPER_PRIVATE_KEY=

# Public endpoints rate-limit and occasionally fail DNS. Use a dedicated
# provider in production.
BSC_RPC_URL=https://bsc-dataseed1.defibit.io

# Alchemy fallback — used automatically if the primary RPC fails.
# Get a key at https://dashboard.alchemy.com (BNB Smart Chain Mainnet).
# https://bnb-mainnet.g.alchemy.com/v2/<YOUR_KEY>
BSC_RPC_URL_ALCHEMY=
