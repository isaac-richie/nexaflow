{
  "name": "nexaflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:rpc": "node scripts/test-rpc-policy.mjs",
    "test:preview": "node --test scripts/test-dashboard-preview.mjs",
    "test:member": "node --test scripts/test-member-dashboard.mjs",
    "test:v6": "node --test scripts/test-v6.mjs scripts/test-v6-transactions.mjs scripts/test-v6-network.mjs",
    "test:v6:integration": "node scripts/test-v6-integration.mjs",
    "test:network": "node --no-warnings --experimental-strip-types --test scripts/test-network-graph.mts && node --test scripts/test-network-cache.mjs",
    "gen:abi": "node scripts/gen-abi.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "8.18.0",
    "@privy-io/react-auth": "3.35.0",
    "@privy-io/wagmi": "4.0.14",
    "@tanstack/react-query": "^5.51.23",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.24",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^2.5.2",
    "three": "0.170.0",
    "viem": "2.52.0",
    "wagmi": "^2.12.7"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "@types/node": "20.14.14",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4"
  }
}
