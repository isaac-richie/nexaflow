# ─────────────────────────────────────────────────────────────────────
#  NexaFlow frontend — environment template
#
#  Copy to .env.local and fill in. .env.local is gitignored; this file is
#  committed, so it must never contain a real secret.
#
#  Every variable here is NEXT_PUBLIC_*, which means Next.js inlines it into
#  the JavaScript bundle sent to the browser. Treat all of it as published.
#  Nothing secret can live in this file — no private key, no mnemonic, and
#  in particular no Privy APP SECRET.
# ─────────────────────────────────────────────────────────────────────

# ── Wallet connection (Privy) ────────────────────────────────────────
#
# Get this from https://dashboard.privy.io → your app → Settings → Basics.
#
# The APP ID is public by design: it identifies your app to Privy from the
# browser and ships in the client bundle. It is NOT the app secret. The app
# secret is server-side only, is never prefixed NEXT_PUBLIC_, and must never
# appear in this project.
#
# In the Privy dashboard, also add your origins to Allowed domains, or login
# will fail in the browser with a domain error:
#   http://localhost:3000      (local development)
#   https://<your-domain>      (production)
NEXT_PUBLIC_PRIVY_APP_ID=

# ── Chain ────────────────────────────────────────────────────────────
# "bsc" for mainnet (chain 56). Anything else falls back to BSC testnet (97).
NEXT_PUBLIC_CHAIN=bsc

# ── Contracts ────────────────────────────────────────────────────────
# The membership contract. With this unset the app renders an explicit
# "not deployed" panel rather than querying 0x0 and showing zeroes as if
# they were real balances.
NEXT_PUBLIC_MEMBERSHIP_ADDRESS=

# The ERC-20 members pay fees in, pinned by ADDRESS rather than symbol.
# On BSC mainnet this is Rawli Analytics (RWAAN), which has 18 decimals.
NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS=0xACB921bf2Dac2F7E8E101AAd9CA013d6Af5C648a

# ── RPC ──────────────────────────────────────────────────────────────
# Optional. Falls back to the chain's public endpoint if unset. Public RPCs
# rate-limit hard; use a dedicated provider before real traffic.
NEXT_PUBLIC_BSC_RPC_URL=
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=

# RPC budget controls. Reads never poll in the background. The polling interval
# applies only while waiting for a submitted transaction receipt (or another
# explicitly watched operation). Values are clamped to safe ranges in code.
NEXT_PUBLIC_RPC_POLLING_INTERVAL_MS=8000
NEXT_PUBLIC_RPC_MULTICALL_WAIT_MS=40

# Alchemy fallback — used automatically if the primary RPC fails.
# Get a key at https://dashboard.alchemy.com (BNB Smart Chain Mainnet).
# https://bnb-mainnet.g.alchemy.com/v2/<YOUR_KEY>
NEXT_PUBLIC_BSC_RPC_URL_ALCHEMY=
