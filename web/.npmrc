# @privy-io/react-auth declares `permissionless` as an OPTIONAL peer (it is the
# account-abstraction path). `permissionless` in turn declares an optional peer
# of `ox@^0.8`, while current viem ships ox 0.14.x. npm refuses the install over
# that chain even though nothing here uses it: embedded wallets and smart
# accounts are switched off in the Privy config, so `permissionless` is never
# loaded.
#
# This is not masking a real version mismatch — the same viem/ox/Privy
# combination runs in production in the RwanV2 app. Revisit if smart accounts
# are ever enabled, at which point the ox constraint becomes real.
legacy-peer-deps=true
